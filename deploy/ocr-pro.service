# ocr-pro 收购平台后端 systemd 服务（部署在 ubuntu 服务器，独立于其他项目）
# 安装：sudo cp deploy/ocr-pro.service /etc/systemd/system/ && sudo systemctl daemon-reload
# 启动：sudo systemctl enable --now ocr-pro
[Unit]
Description=ocr-pro grain purchase platform backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/ocr-pro/platform/backend
ExecStart=/home/ubuntu/apps/ocr-pro/platform/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
