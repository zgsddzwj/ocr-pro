<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-bg">
      <view class="hero-deco deco-1" />
      <view class="hero-deco deco-2" />
    </view>
    <view class="hero-top">
      <view class="hero-titles">
        <view class="hero-title">收粮收购助手</view>
        <view class="hero-sub">识别身份证 · 开收购单 · 统计导出</view>
      </view>
      <view class="hero-gear" hover-class="press" bindtap="openSettings">
        <image class="hero-gear-icon" src="{{icons.settingsWhite}}" />
      </view>
    </view>
    <view class="hero-status {{connected === true ? 'ok' : connected === false ? 'bad' : ''}}"
          bindtap="onStatusTap">
      <view class="dot" />
      <text class="status-text">{{connectionText}}</text>
    </view>
  </view>

  <!-- 主操作区 -->
  <view class="actions">
    <!-- 主入口：扫证识别 -->
    <view class="scan-card" hover-class="card-press" bindtap="goOcr">
      <view class="scan-bg">
        <view class="scan-deco sdeco-1" />
        <view class="scan-deco sdeco-2" />
      </view>
      <view class="scan-icon">
        <image class="scan-icon-img" src="{{icons.camera}}" />
      </view>
      <view class="scan-body">
        <view class="scan-title">扫证识别</view>
        <view class="scan-sub">拍一下身份证，自动识别姓名、号码、住址</view>
        <view class="scan-cta">开始识别 ›</view>
      </view>
    </view>

    <!-- 次入口：收购工作台 -->
    <view class="bench-card" hover-class="card-press" bindtap="goRecords">
      <view class="bench-icon">
        <image class="bench-icon-img" src="{{icons.idcard}}" />
      </view>
      <view class="bench-body">
        <view class="bench-title">收购工作台</view>
        <view class="bench-sub">统计 · 开单 · 农户管理</view>
      </view>
      <view class="bench-arrow">›</view>
    </view>
  </view>

  <!-- 最近识别 -->
  <view class="recent">
    <view class="recent-head">
      <text class="recent-title">最近识别</text>
      <text class="recent-count" wx:if="{{historyCount}}">共 {{historyCount}} 条</text>
      <text class="recent-all" wx:if="{{recent.length}}" bindtap="goHistory">全部 ›</text>
    </view>
    <block wx:if="{{recent.length}}">
      <view wx:for="{{recent}}" wx:key="id" class="recent-row">
        <text class="recent-name">{{item.name || '未识别姓名'}}</text>
        <text class="recent-time">{{item.timeText}}</text>
      </view>
    </block>
    <view wx:else class="recent-empty">
      <view class="empty-icon">
        <image class="empty-icon-img" src="{{icons.history}}" />
      </view>
      <view class="empty-text">还没有识别记录</view>
      <view class="empty-hint">点上方「开始识别」，扫一下身份证试试</view>
    </view>
  </view>

  <view class="footer">收粮收购助手 · 让收购登记更简单</view>

  <view class="mask" wx:if="{{showSettings}}" bindtap="closeSettings">
    <view class="sheet" catchtap="noop">
      <view class="sheet-bar" />
      <view class="sheet-title">设置</view>

      <view class="field">
        <view class="field-label">单位名称（单据抬头）</view>
        <input class="field-input" value="{{settings.companyTitle}}"
               placeholder="如：××农产品有限公司" placeholder-class="ph"
               bindinput="onCompanyInput" />
      </view>
      <view class="field">
        <view class="field-label">识别服务地址</view>
        <input class="field-input" value="{{settings.serverBase}}"
               placeholder="http://电脑局域网IP:3000" placeholder-class="ph"
               bindinput="onServerInput" />
      </view>
      <view class="field-hint">填电脑上启动服务时打印的局域网地址或公网隧道地址，改完可先「测试连接」</view>
      <view class="field-hint">当前生效地址：{{effectiveBase}}</view>

      <view class="sheet-buttons">
        <button class="btn btn-ghost btn-sm sheet-btn" bindtap="testConnection"
                disabled="{{testing}}">{{testing ? '测试中…' : '测试连接'}}</button>
        <button class="btn btn-primary btn-sm sheet-btn" bindtap="saveSettings">保存</button>
      </view>
      <view wx:if="{{testResult}}" class="test-result {{testState}}">{{testResult}}</view>
    </view>
  </view>
</view>
