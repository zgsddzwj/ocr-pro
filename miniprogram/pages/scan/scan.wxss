.page {
  padding-bottom: 80rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  position: relative;
  padding: 44rpx 36rpx 76rpx;
  background: linear-gradient(150deg, #26814F 0%, #1E6F43 52%, #175A35 100%);
  border-radius: 0 0 44rpx 44rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.hero-gear {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-gear-icon {
  width: 38rpx;
  height: 38rpx;
}

.hero-status {
  position: absolute;
  left: 36rpx;
  bottom: -24rpx;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
  max-width: calc(100% - 72rpx);
}

.hero-status .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9AA6A0;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.hero-status.ok .dot {
  background: #2E9E5B;
}

.hero-status.bad .dot {
  background: #D97A6C;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 主操作卡 ---------- */
.main-card {
  margin: 58rpx 32rpx 0;
  padding: 32rpx 32rpx 36rpx;
}

.scan-visual {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #EDF4F0 0%, #E2EDE6 100%);
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-preview {
  width: 100%;
  height: 100%;
}

.id-mock {
  width: 360rpx;
  height: 216rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 3rpx dashed #A9CDB8;
  position: relative;
  box-shadow: 0 8rpx 20rpx rgba(23, 40, 31, 0.08);
}

.mock-portrait {
  position: absolute;
  left: 26rpx;
  top: 44rpx;
  width: 76rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #CDE2D5;
}

.mock-lines {
  position: absolute;
  left: 124rpx;
  top: 52rpx;
}

.mock-line {
  height: 14rpx;
  border-radius: 7rpx;
  background: #C4DBCB;
  margin-bottom: 22rpx;
}

.mock-line.l1 { width: 140rpx; }
.mock-line.l2 { width: 190rpx; }
.mock-line.l3 { width: 160rpx; }

.mock-chip {
  position: absolute;
  right: 26rpx;
  bottom: 26rpx;
  width: 58rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #D9C294;
}

.btn-gap {
  margin-top: 22rpx;
}

/* ---------- 三步说明 ---------- */
.steps {
  margin: 24rpx 32rpx 0;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: flex-start;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
}

.step-line {
  flex: 0 0 56rpx;
  height: 2rpx;
  background: var(--line);
  margin: 21rpx 14rpx 0;
}

/* ---------- 提示 ---------- */
.tips {
  margin: 30rpx 44rpx 0;
}

.tip {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 42rpx;
}

.tip::before {
  content: '·';
  margin-right: 10rpx;
  color: #C4D2C9;
}

/* ---------- 历史入口 ---------- */
.entry {
  margin: 32rpx 32rpx 0;
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  display: flex;
  align-items: center;
}

.entry-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.entry-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.entry-arrow {
  margin-left: 18rpx;
  color: var(--text-3);
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 300;
}

/* ---------- 设置弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 20, 14, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  animation: fade 0.2s ease-out;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: rise 0.22s ease-out;
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 0 auto 26rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
}

.ph {
  color: var(--text-3);
}

.field-hint {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 36rpx;
  margin-bottom: 26rpx;
}

.sheet-buttons {
  display: flex;
}

.sheet-btn {
  flex: 1;
}

.sheet-btn + .sheet-btn {
  margin-left: 20rpx;
}

.test-result {
  margin-top: 22rpx;
  font-size: 26rpx;
  text-align: center;
}

.test-result.ok {
  color: var(--brand);
}

.test-result.bad {
  color: var(--danger);
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rise {
  from { transform: translateY(30%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

/* ---------- 双主入口 ---------- */
.dual {
  display: flex;
  gap: 20rpx;
  margin-top: 58rpx;
}

.dual-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 40, 31, 0.05);
}

.dual-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #e8f3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.dual-icon.dark {
  background: #1f6f43;
}

.dual-img {
  width: 40rpx;
  height: 40rpx;
}

.dual-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #14361f;
}

.dual-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa69e;
}
