.page {
  padding-bottom: 80rpx;
}

/* ---------- 顶部品牌区 ---------- */
.hero {
  position: relative;
  padding: 48rpx 36rpx 84rpx;
  background: linear-gradient(150deg, #2A8A55 0%, #1E6F43 55%, #14532D 100%);
  border-radius: 0 0 44rpx 44rpx;
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  border-radius: inherit;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.deco-1 {
  width: 340rpx;
  height: 340rpx;
  right: -110rpx;
  top: -150rpx;
}

.deco-2 {
  width: 220rpx;
  height: 220rpx;
  left: -90rpx;
  bottom: -130rpx;
  background: rgba(255, 255, 255, 0.05);
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.hero-gear {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-gear-icon {
  width: 38rpx;
  height: 38rpx;
}

.hero-status {
  position: absolute;
  left: 36rpx;
  bottom: -26rpx;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
  max-width: calc(100% - 72rpx);
}

.hero-status .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9AA6A0;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.hero-status.ok .dot {
  background: #2E9E5B;
}

.hero-status.bad .dot {
  background: #D97A6C;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 主操作区 ---------- */
.actions {
  margin: 58rpx 32rpx 0;
}

/* 主入口：扫证识别大卡 */
.scan-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #278550 0%, #1E6F43 58%, #175A35 100%);
  box-shadow: 0 14rpx 32rpx rgba(30, 111, 67, 0.26);
}

.scan-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  border-radius: inherit;
}

.scan-deco {
  position: absolute;
  border-radius: 50%;
}

.sdeco-1 {
  width: 280rpx;
  height: 280rpx;
  right: -80rpx;
  top: -130rpx;
  background: rgba(255, 255, 255, 0.09);
}

.sdeco-2 {
  width: 170rpx;
  height: 170rpx;
  right: 170rpx;
  bottom: -100rpx;
  background: rgba(255, 255, 255, 0.06);
}

.scan-icon {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.scan-icon-img {
  width: 54rpx;
  height: 54rpx;
}

.scan-body {
  position: relative;
  flex: 1;
  min-width: 0;
  margin-left: 30rpx;
}

.scan-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.scan-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  line-height: 34rpx;
}

.scan-cta {
  margin-top: 26rpx;
  display: inline-flex;
  align-items: center;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--brand);
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(10, 30, 18, 0.2);
}

/* 次入口：收购工作台行卡 */
.bench-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid #EEF2EF;
  box-shadow: 0 6rpx 20rpx rgba(23, 40, 31, 0.07);
}

.bench-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bench-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.bench-body {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.bench-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.bench-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.bench-arrow {
  margin-left: 16rpx;
  color: #C0C9C3;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* ---------- 按压反馈 ---------- */
.card-press {
  transform: scale(0.98);
  opacity: 0.9;
}

.press {
  opacity: 0.7;
}

/* ---------- 最近识别 ---------- */
.recent {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 40, 31, 0.05);
}

.recent-head {
  display: flex;
  align-items: center;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

.recent-count {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.recent-all {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--brand);
}

.recent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0 6rpx;
  border-bottom: 2rpx dashed #EEF2EF;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}

.recent-time {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 空状态 */
.recent-empty {
  padding: 40rpx 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-img {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.65;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: #C0C9C3;
}

/* ---------- 设置弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 20, 14, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  animation: fade 0.2s ease-out;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: rise 0.22s ease-out;
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 0 auto 26rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
}

.ph {
  color: var(--text-3);
}

.field-hint {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 36rpx;
  margin-bottom: 26rpx;
}

.sheet-buttons {
  display: flex;
}

.sheet-btn {
  flex: 1;
}

.sheet-btn + .sheet-btn {
  margin-left: 20rpx;
}

.test-result {
  margin-top: 22rpx;
  font-size: 26rpx;
  text-align: center;
}

.test-result.ok {
  color: var(--brand);
}

.test-result.bad {
  color: var(--danger);
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rise {
  from { transform: translateY(30%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
