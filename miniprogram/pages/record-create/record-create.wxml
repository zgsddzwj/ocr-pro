<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card">
    <view class="section-title">① 卖方农户</view>
    <view wx:if="{{farmer}}" class="farmer-ok">
      <view class="farmer-info">
        <view class="farmer-name">{{farmer.name}}</view>
        <view class="farmer-meta">{{farmer.idNumber}}</view>
        <view class="farmer-meta">{{farmer.address}}</view>
      </view>
      <view class="farmer-reset" bindtap="resetFarmer">重选</view>
    </view>
    <block wx:else>
      <input class="input" value="{{farmerQuery}}" bindinput="onFarmerQuery"
             placeholder="输入姓名或身份证号搜索农户" placeholder-class="ph" />
      <view wx:if="{{showResults && farmerResults.length}}" class="results">
        <view wx:for="{{farmerResults}}" wx:key="id" class="result-row"
              data-id="{{item.id}}" bindtap="pickFarmer">
          <text class="result-name">{{item.name}}</text>
          <text class="result-meta">{{item.idNumber}}</text>
        </view>
      </view>
      <view class="link" bindtap="toggleManual">{{manualFarmer ? '收起手填' : '找不到？现场手填农户信息'}}</view>
      <block wx:if="{{manualFarmer}}">
        <input class="input gap" value="{{manual.name}}" data-k="name" bindinput="onManualInput"
               placeholder="姓名 *" placeholder-class="ph" />
        <input class="input gap" type="idcard" value="{{manual.idNumber}}" data-k="idNumber"
               bindinput="onManualInput" placeholder="身份证号 *" placeholder-class="ph" />
        <input class="input gap" value="{{manual.address}}" data-k="address"
               bindinput="onManualInput" placeholder="地址" placeholder-class="ph" />
      </block>
    </block>
  </view>

  <view class="card">
    <view class="section-title">② 收购信息</view>
    <view class="grid2">
      <view>
        <view class="label">日期</view>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="input picker">{{form.date}}</view>
        </picker>
      </view>
      <view>
        <view class="label">品名</view>
        <input class="input" value="{{form.product}}" data-k="product" bindinput="setField" />
      </view>
    </view>
    <view class="grid3 gap-top">
      <view>
        <view class="label">毛重（公斤）</view>
        <input class="input big" type="digit" value="{{form.gross}}" data-k="gross" bindinput="setField" placeholder="0" />
      </view>
      <view>
        <view class="label">皮重（公斤）</view>
        <input class="input big" type="digit" value="{{form.tare}}" data-k="tare" bindinput="setField" placeholder="0" />
      </view>
      <view>
        <view class="label">单价（元/公斤）</view>
        <input class="input big" type="digit" value="{{form.pricePerKg}}" data-k="pricePerKg" bindinput="setField" placeholder="0" />
      </view>
    </view>

    <view class="computed">
      <view class="c-item">
        <view class="c-label">净重</view>
        <view class="c-value">{{computed.netWeightText}}</view>
      </view>
      <view class="c-item">
        <view class="c-label">计价净重</view>
        <view class="c-value brand">{{computed.pricedWeightText}}</view>
      </view>
      <view class="c-item">
        <view class="c-label">结算价款</view>
        <view class="c-value brand">{{computed.totalAmountText}}</view>
      </view>
    </view>
    <view wx:if="{{overDeducted}}" class="warn">扣量合计已超过净重，请检查扣量数字</view>
  </view>

  <view class="card">
    <view class="more-toggle" bindtap="toggleMore">
      <view class="section-title inline">③ 更多选项 <text class="more-hint">扣量、化验数据、银行账户等，选填</text></view>
      <text class="more-arrow">{{showMore ? '收起 ▲' : '展开 ▼'}}</text>
    </view>

    <block wx:if="{{showMore}}">
      <view class="more-title">扣量与化验</view>
      <view class="grid3 gap-top">
        <view><view class="label">卸车费（元）</view>
          <input class="input" type="digit" value="{{form.unloadFee}}" data-k="unloadFee" bindinput="setField" /></view>
        <view><view class="label">水分%</view>
          <input class="input" type="digit" value="{{form.moisture}}" data-k="moisture" bindinput="setField" /></view>
        <view><view class="label">杂质%</view>
          <input class="input" type="digit" value="{{form.impurity}}" data-k="impurity" bindinput="setField" /></view>
        <view><view class="label">生霉粒%</view>
          <input class="input" type="digit" value="{{form.moldy}}" data-k="moldy" bindinput="setField" /></view>
        <view><view class="label">场地扣量</view>
          <input class="input" type="digit" value="{{form.deductSite}}" data-k="deductSite" bindinput="setField" /></view>
        <view><view class="label">水分扣量</view>
          <input class="input" type="digit" value="{{form.deductMoisture}}" data-k="deductMoisture" bindinput="setField" /></view>
        <view><view class="label">杂质扣量</view>
          <input class="input" type="digit" value="{{form.deductImpurity}}" data-k="deductImpurity" bindinput="setField" /></view>
        <view><view class="label">生霉扣量</view>
          <input class="input" type="digit" value="{{form.deductMoldy}}" data-k="deductMoldy" bindinput="setField" /></view>
      </view>

      <view class="more-title">单据信息</view>
      <view class="grid2 gap-top">
        <view><view class="label">等级</view>
          <input class="input" value="{{form.grade}}" data-k="grade" bindinput="setField" /></view>
        <view><view class="label">车号</view>
          <input class="input" value="{{form.vehicleNo}}" data-k="vehicleNo" bindinput="setField" /></view>
        <view><view class="label">卸车货位</view>
          <input class="input" value="{{form.unloadSpot}}" data-k="unloadSpot" bindinput="setField" /></view>
        <view><view class="label">入库仓号</view>
          <input class="input" value="{{form.warehouse}}" data-k="warehouse" bindinput="setField" /></view>
        <view><view class="label">联系电话</view>
          <input class="input" type="number" value="{{form.phone}}" data-k="phone" bindinput="setField" /></view>
        <view><view class="label">银行卡号</view>
          <input class="input" type="number" value="{{form.bankCard}}" data-k="bankCard" bindinput="setField" /></view>
        <view><view class="label">开户行</view>
          <input class="input" value="{{form.bankName}}" data-k="bankName" bindinput="setField" /></view>
      </view>

      <view class="more-title">备注</view>
      <input class="input" value="{{form.note}}" data-k="note" bindinput="setField" placeholder="备注" placeholder-class="ph" />
    </block>
  </view>

  <view class="save-bar">
    <view class="save-amount">
      <text class="save-label">结算价款：</text>
      <text class="save-value">{{computed.totalAmountText}}</text>
      <text class="save-hint">元（大写随单据生成）</text>
    </view>
    <button class="save-btn" loading="{{busy}}" bindtap="save">保存单据</button>
  </view>
</view>
