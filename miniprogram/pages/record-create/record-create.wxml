<view class="page">
  <view wx:if="{{needLogin}}" class="login-gate">
    <view class="gate-icon">
      <image class="gate-icon-img" src="{{icons.idcard}}" />
    </view>
    <view class="gate-title">开单前先登录平台</view>
    <view class="gate-sub">登录后才能搜索农户、保存收购单据</view>
    <button class="btn btn-primary gate-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card">
    <view class="section-title">① 卖方农户</view>
    <view wx:if="{{farmer}}" class="farmer-ok">
      <view class="farmer-info">
        <view class="farmer-name">{{farmer.name}}</view>
        <view class="farmer-meta">{{farmer.idNumber}}</view>
        <view class="farmer-meta">{{farmer.address}}</view>
      </view>
      <view class="farmer-reset" bindtap="resetFarmer">重选</view>
    </view>
    <block wx:else>
      <input class="input" value="{{farmerQuery}}" bindinput="onFarmerQuery"
             placeholder="输入姓名或身份证号搜索农户" placeholder-class="ph" />
      <view wx:if="{{showResults && farmerResults.length}}" class="results">
        <view wx:for="{{farmerResults}}" wx:key="id" class="result-row"
              data-id="{{item.id}}" bindtap="pickFarmer">
          <text class="result-name">{{item.name}}</text>
          <text class="result-meta">{{item.idNumber}}</text>
        </view>
      </view>
      <view class="link" bindtap="toggleManual">{{manualFarmer ? '收起手填' : '找不到？现场手填农户信息'}}</view>
      <block wx:if="{{manualFarmer}}">
        <input class="input gap" value="{{manual.name}}" data-k="name" bindinput="onManualInput"
               placeholder="姓名 *" placeholder-class="ph" />
        <input class="input gap" type="idcard" value="{{manual.idNumber}}" data-k="idNumber"
               bindinput="onManualInput" placeholder="身份证号 *" placeholder-class="ph" />
        <input class="input gap" value="{{manual.address}}" data-k="address"
               bindinput="onManualInput" placeholder="地址" placeholder-class="ph" />
      </block>
    </block>
  </view>

  <view class="card">
    <view class="section-title">② 收购信息</view>
    <view class="grid2">
      <view>
        <view class="label">日期</view>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="input picker">{{form.date}}</view>
        </picker>
      </view>
      <view>
        <view class="label">产品名称</view>
        <input class="input" value="{{form.product}}" data-k="product" bindinput="setField" />
      </view>
    </view>

    <view class="grid3 gap-top">
      <view>
        <view class="label">产品等级</view>
        <input class="input" value="{{form.grade}}" data-k="grade" bindinput="setField" placeholder="如：一等" placeholder-class="ph" />
      </view>
      <view>
        <view class="label">水分%</view>
        <input class="input" type="digit" value="{{form.moisture}}" data-k="moisture" bindinput="setField" placeholder="0" placeholder-class="ph" />
      </view>
      <view>
        <view class="label">杂质霉变%</view>
        <input class="input" type="digit" value="{{form.impurity}}" data-k="impurity" bindinput="setField" placeholder="0" placeholder-class="ph" />
      </view>
    </view>

    <view class="grid3 gap-top">
      <view>
        <view class="label">毛重（公斤）</view>
        <input class="input big" type="digit" value="{{form.gross}}" data-k="gross" bindinput="setField" placeholder="0" />
      </view>
      <view>
        <view class="label">皮重（公斤）</view>
        <input class="input big" type="digit" value="{{form.tare}}" data-k="tare" bindinput="setField" placeholder="0" />
      </view>
      <view>
        <view class="label">综合扣量（公斤）</view>
        <input class="input big" type="digit" value="{{form.deductTotal}}" data-k="deductTotal" bindinput="setField" placeholder="0" />
      </view>
    </view>

    <view class="grid3 gap-top">
      <view>
        <view class="label">单价（元/公斤）</view>
        <input class="input big" type="digit" value="{{form.pricePerKg}}" data-k="pricePerKg" bindinput="setField" placeholder="0" />
      </view>
      <view>
        <view class="label">卸车货位</view>
        <input class="input" value="{{form.unloadSpot}}" data-k="unloadSpot" bindinput="setField" placeholder="如：3号位" placeholder-class="ph" />
      </view>
      <view>
        <view class="label">银行账号</view>
        <input class="input" type="number" value="{{form.bankCard}}" data-k="bankCard" bindinput="setField" placeholder="结算收款账号" placeholder-class="ph" />
      </view>
    </view>

    <view class="grid3 gap-top">
      <view>
        <view class="label">联系电话</view>
        <input class="input" type="number" value="{{form.phone}}" data-k="phone" bindinput="setField" placeholder="如：13800000000" placeholder-class="ph" />
      </view>
      <view>
        <view class="label">毛检时间</view>
        <input class="input" value="{{form.weighInAt}}" data-k="weighInAt" bindinput="setField" placeholder="如：08:30" placeholder-class="ph" />
      </view>
      <view>
        <view class="label">皮检时间</view>
        <input class="input" value="{{form.weighOutAt}}" data-k="weighOutAt" bindinput="setField" placeholder="如：09:10" placeholder-class="ph" />
      </view>
    </view>

    <view class="grid2 gap-top">
      <view>
        <view class="label">化验员</view>
        <input class="input" value="{{form.checker}}" data-k="checker" bindinput="setField" />
      </view>
      <view>
        <view class="label">监管员</view>
        <input class="input" value="{{form.supervisor}}" data-k="supervisor" bindinput="setField" />
      </view>
    </view>

    <view class="computed">
      <view class="c-item">
        <view class="c-label">净重</view>
        <view class="c-value brand">{{computed.pricedWeightText}}</view>
      </view>
      <view class="c-item">
        <view class="c-label">市斤价</view>
        <view class="c-value">{{computed.pricePerJinText}}</view>
      </view>
      <view class="c-item">
        <view class="c-label">金额</view>
        <view class="c-value brand">{{computed.grainAmountText}}</view>
      </view>
    </view>
    <view wx:if="{{overDeducted}}" class="warn">综合扣量已超过毛重减皮重，请检查扣量数字</view>
  </view>

  <view class="save-bar">
    <view class="save-amount">
      <text class="save-label">金额：</text>
      <text class="save-value">{{computed.grainAmountText}}</text>
      <text class="save-hint">元（大写随单据生成）</text>
    </view>
    <button class="save-btn" loading="{{busy}}" bindtap="save">保存单据</button>
  </view>
  </block>
</view>
