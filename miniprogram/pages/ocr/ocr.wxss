.page {
  min-height: 100vh;
  background: #f3f6f4;
  padding-bottom: 60rpx;
}

.hero {
  padding: 44rpx 36rpx 44rpx;
  background: linear-gradient(150deg, #26814F 0%, #1E6F43 52%, #175A35 100%);
  border-radius: 0 0 44rpx 44rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.main-card {
  margin: 32rpx 32rpx 0;
  padding: 32rpx 32rpx 36rpx;
}

.scan-visual {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #edf4f0 0%, #e2ede6 100%);
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-preview {
  width: 100%;
  height: 100%;
}

.id-mock {
  width: 360rpx;
  height: 216rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 3rpx dashed #a9cdb8;
  position: relative;
  box-shadow: 0 8rpx 20rpx rgba(23, 40, 31, 0.08);
}

.mock-portrait {
  position: absolute;
  left: 26rpx;
  top: 44rpx;
  width: 76rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #cde2d5;
}

.mock-lines {
  position: absolute;
  left: 124rpx;
  top: 52rpx;
}

.mock-line {
  height: 14rpx;
  border-radius: 7rpx;
  background: #c4dbcb;
  margin-bottom: 22rpx;
}

.mock-line.l1 { width: 140rpx; }
.mock-line.l2 { width: 190rpx; }
.mock-line.l3 { width: 160rpx; }

.mock-chip {
  position: absolute;
  right: 26rpx;
  bottom: 26rpx;
  width: 58rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #d9c294;
}

.btn-gap {
  margin-top: 22rpx;
}

.tips {
  margin: 32rpx 44rpx 0;
}

.tip {
  font-size: 24rpx;
  color: #9aa69e;
  line-height: 42rpx;
}

.tip::before {
  content: '·';
  margin-right: 10rpx;
  color: #c4d2c9;
}

.entry {
  margin: 32rpx 32rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 40, 31, 0.05);
  padding: 28rpx;
  display: flex;
  align-items: center;
}

.entry-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.entry-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #1f6f43;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.entry-arrow {
  margin-left: 18rpx;
  color: #9aa69e;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 300;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
