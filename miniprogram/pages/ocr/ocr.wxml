<view class="page">
  <view class="hero">
    <view class="hero-title">OCR 身份证识别</view>
    <view class="hero-sub">拍一下证件，姓名 · 身份证号 · 住址自动提取</view>
  </view>

  <view class="card main-card">
    <view class="scan-visual">
      <image wx:if="{{previewPath}}" class="scan-preview" src="{{previewPath}}" mode="aspectFill" />
      <view wx:else class="id-mock">
        <view class="mock-portrait" />
        <view class="mock-lines">
          <view class="mock-line l1" />
          <view class="mock-line l2" />
          <view class="mock-line l3" />
        </view>
        <view class="mock-chip" />
      </view>
    </view>

    <button class="btn btn-primary" bindtap="onScan" disabled="{{recognizing}}">
      <image class="btn-icon" src="{{icons.camera}}" />
      <text>{{recognizing ? '正在识别…' : '拍照识别身份证'}}</text>
    </button>
    <button class="btn btn-secondary btn-gap" bindtap="onPickAlbum" disabled="{{recognizing}}">
      <image class="btn-icon" src="{{icons.image}}" />
      <text>从相册选择</text>
    </button>
  </view>

  <view class="tips">
    <view class="tip">请拍身份证人像面（有姓名、住址、号码的一面）</view>
    <view class="tip">光线充足、证件摆正、避免反光，识别更准</view>
    <view class="tip">识别结果可手动修改后再使用</view>
  </view>

  <view class="entry" bindtap="goHistory">
    <image class="icon" src="{{icons.history}}" />
    <text class="entry-text">识别历史</text>
    <view class="entry-badge" wx:if="{{historyCount}}">{{historyCount}}</view>
    <view class="entry-arrow">›</view>
  </view>
</view>
